# Postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contracts
# For Docker Compose use: postgresql+psycopg://postgres:postgres@postgres:5432/contracts

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
# For Docker Compose use: http://opensearch:9200

# Object Store (MinIO)
S3_ENDPOINT=http://localhost:9000
# For Docker Compose use: http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contracts
S3_REGION=us-east-1

# NATS
NATS_URL=nats://localhost:4222
# For Docker Compose use: nats://nats:4222

# Auth (Keycloak dev)
OIDC_ISSUER=http://localhost:8081/realms/master
OIDC_AUDIENCE=contract-ai
OIDC_JWKS_URL=http://localhost:8081/realms/master/protocol/openid-connect/certs

# LLM (example envs; choose your provider)
OPENAI_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini

# Misc
ENV=dev

# Security Gate (Agent 4)
SECURITY_GATE__STORAGE_DIR=storage/uploads
SECURITY_GATE__AUDIT_DIR=storage/audit
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_GATE__FERNET_KEY=
SECURITY_GATE__MAX_FILE_MB=15
SECURITY_GATE__ALLOWED_ORIGINS=http://localhost:5173
SECURITY_GATE__ALLOWED_EXTS=pdf,docx
# SECURITY_GATE__INGEST_URL=http://ingest_indexer:8001
# SECURITY_GATE__CLAUSE_URL=http://clause_extractor:8002
# SECURITY_GATE__RISK_URL=http://risk_detector:8003
# SECURITY_GATE__RECOMMEND_URL=http://recommender:8004
# SECURITY_GATE__CHAT_URL=http://chat_agent:8007

# Orchestrator (Agent 4)
ORCH_SECURITY_GATE_URL=http://127.0.0.1:8000
ORCH_ALLOWED_ORIGINS=http://localhost:5173
ORCH_JWT_SECRET=
ORCH_JWT_EXPIRES_MIN=60
ORCH_USERNAME=admin
ORCH_PASSWORD=admin123!
ORCH_AUDIT_DIR=storage/audit

# Clause Extractor
# CLAUSE_EXTRACTOR__INGEST_URL=http://security_gate:8000

# Risk Detector
# RISK_DETECTOR__CLAUSE_URL=http://security_gate:8000
